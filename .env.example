# Athena FabVision runtime configuration.
# Copy to .env (never commit .env) and fill in values.

# --- Django runtime ---------------------------------------------------------

# Required. Secret key for cryptographic signing.
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=

# Optional. Defaults to false (production-safe) when unset.
DJANGO_DEBUG=false

# Optional. Comma-separated hostnames the site may be served from.
# Defaults to localhost,127.0.0.1 when unset.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Integration keys (all optional) ---------------------------------------
# The app boots with none of these configured and serves a
# degraded-but-alive state; the features that need a key report
# themselves as unavailable.

# OpenAI (chat + embeddings)
OPENAI_API_KEY=

# LiveKit (voice)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Google Programmable Search (web search tool)
GOOGLE_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=
